{
  "name": "QTranslate Dark",
  "dark": true,
  "author": "QTranslate",
  "parentTheme": "Darcula",
  "colors": {
    "canvas": "#10161A",
    "surface": "#161E23",
    "surfaceRaised": "#1D272C",
    "surfaceHover": "#243036",
    "foreground": "#E6E4DF",
    "mutedForeground": "#97A3A8",
    "disabledForeground": "#5F6C71",
    "border": "#232F35",
    "borderStrong": "#35444B",
    "accent": "#45C4B0",
    "accentHover": "#5DD4C1",
    "accentSoft": "#17383A",
    "accentForeground": "#06201C",
    "selection": "#1E4E4C",
    "selectionInactive": "#2A363B",
    "link": "#6FB2E8",
    "success": "#5FC08A",
    "warning": "#E0B15C",
    "error": "#EF7B84"
  },
  "ui": {
    "*": {
      "background": "canvas",
      "foreground": "foreground",
      "borderColor": "border",
      "disabledBackground": "surface",
      "disabledForeground": "disabledForeground",
      "inactiveForeground": "mutedForeground",
      "hoverBackground": "surfaceHover",
      "selectionBackground": "selection",
      "selectionForeground": "foreground",
      "selectionInactiveBackground": "selectionInactive",
      "selectionInactiveForeground": "foreground",
      "focusColor": "accent",
      "accentColor": "accent",
      "infoForeground": "mutedForeground"
    },
    "Panel": { "background": "canvas", "foreground": "foreground" },
    "Component": {
      "borderColor": "borderStrong",
      "focusedBorderColor": "accent",
      "focusColor": "#45C4B066",
      "errorFocusColor": "error",
      "warningFocusColor": "warning"
    },
    "Button": {
      "foreground": "foreground",
      "startBackground": "surfaceRaised",
      "endBackground": "surfaceRaised",
      "startBorderColor": "borderStrong",
      "endBorderColor": "borderStrong",
      "hoverBackground": "surfaceHover",
      "pressedBackground": "selectionInactive",
      "default": {
        "foreground": "accentForeground",
        "startBackground": "accent",
        "endBackground": "accent",
        "startBorderColor": "accent",
        "endBorderColor": "accent",
        "hoverBackground": "accentHover",
        "pressedBackground": "#37A796",
        "focusedBorderColor": "accentHover"
      }
    },
    "TextField": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "TextArea": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "TextPane": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "EditorPane": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "PasswordField": { "background": "surface" },
    "FormattedTextField": { "background": "surface" },
    "ComboBox": {
      "background": "surface",
      "buttonBackground": "surface",
      "buttonEditableBackground": "surface",
      "selectionBackground": "selection",
      "selectionForeground": "foreground"
    },
    "Spinner": { "background": "surface", "buttonBackground": "surfaceRaised" },
    "List": { "background": "surface", "selectionBackground": "selection", "selectionForeground": "foreground" },
    "Table": {
      "background": "surface",
      "foreground": "foreground",
      "gridColor": "border",
      "stripeColor": "#1B242A",
      "selectionBackground": "selection",
      "selectionForeground": "foreground"
    },
    "TableHeader": { "background": "surfaceRaised", "foreground": "foreground", "bottomSeparatorColor": "borderStrong" },
    "Tree": { "background": "surface", "selectionBackground": "selection", "selectionForeground": "foreground" },
    "Menu": { "selectionBackground": "surfaceHover", "selectionForeground": "foreground" },
    "MenuItem": { "selectionBackground": "surfaceHover", "selectionForeground": "foreground", "acceleratorForeground": "mutedForeground" },
    "PopupMenu": { "background": "surfaceRaised", "borderColor": "borderStrong" },
    "ToolTip": { "background": "#E6E4DF", "foreground": "#10161A", "borderColor": "#E6E4DF" },
    "Separator": { "separatorColor": "border" },
    "ScrollBar": { "track": "canvas", "thumb": "#35444B", "hoverThumbColor": "#4C5F67" },
    "ProgressBar": { "trackColor": "surfaceRaised", "progressColor": "accent", "indeterminateStartColor": "link", "indeterminateEndColor": "accent" },
    "TabbedPane": { "underlineColor": "accent", "hoverColor": "surfaceHover", "focusColor": "surfaceHover", "contentAreaColor": "border" },
    "TitlePane": { "background": "canvas", "foreground": "foreground", "inactiveBackground": "surface", "inactiveForeground": "mutedForeground" },
    "StatusBar": { "background": "canvas", "borderColor": "border" },
    "Link": { "activeForeground": "link", "hoverForeground": "#94C8F0", "pressedForeground": "#B0D9F5", "visitedForeground": "#AE9BE0" },
    "Label": { "disabledForeground": "disabledForeground", "errorForeground": "error", "successForeground": "success" },
    "CheckBox": { "icon": { "selectedBackground": "accent", "selectedBorderColor": "accent", "checkmarkColor": "accentForeground", "focusColor": "accent" } },
    "RadioButton": { "icon": { "selectedBackground": "accent", "selectedBorderColor": "accent", "dotColor": "accentForeground", "focusColor": "accent" } }
  }
}
