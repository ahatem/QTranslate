{
  "name": "QTranslate Light",
  "dark": false,
  "author": "QTranslate",
  "parentTheme": "IntelliJ",
  "colors": {
    "canvas": "#F6F2E9",
    "surface": "#FBF8F1",
    "surfaceMuted": "#EAE4D6",
    "surfaceHover": "#E3DCC9",
    "foreground": "#1E1D1A",
    "mutedForeground": "#5F5B4C",
    "disabledForeground": "#807B6A",
    "border": "#DDD6C5",
    "borderStrong": "#C0B79F",
    "accent": "#B8943A",
    "accentHover": "#A6842F",
    "accentSoft": "#F0E6CC",
    "accentForeground": "#1E1D1A",
    "bronze": "#8A6A1E",
    "selection": "#EADFBF",
    "selectionInactive": "#EDE8DB",
    "link": "#8A6A1E",
    "success": "#4A6B1F",
    "warning": "#8F5714",
    "error": "#B0342F"
  },
  "ui": {
    "*": {
      "background": "canvas",
      "foreground": "foreground",
      "borderColor": "border",
      "disabledBackground": "surfaceMuted",
      "disabledForeground": "disabledForeground",
      "inactiveForeground": "mutedForeground",
      "hoverBackground": "surfaceHover",
      "selectionBackground": "selection",
      "selectionForeground": "foreground",
      "selectionInactiveBackground": "selectionInactive",
      "selectionInactiveForeground": "foreground",
      "focusColor": "bronze",
      "accentColor": "bronze",
      "infoForeground": "mutedForeground"
    },
    "Panel": { "background": "canvas", "foreground": "foreground" },
    "Component": {
      "borderColor": "borderStrong",
      "focusedBorderColor": "bronze",
      "focusColor": "#8A6A1E4D",
      "errorFocusColor": "error",
      "warningFocusColor": "warning"
    },
    "Button": {
      "foreground": "foreground",
      "startBackground": "surface",
      "endBackground": "surface",
      "startBorderColor": "borderStrong",
      "endBorderColor": "borderStrong",
      "hoverBackground": "surfaceHover",
      "pressedBackground": "selection",
      "default": {
        "foreground": "accentForeground",
        "startBackground": "accent",
        "endBackground": "accent",
        "startBorderColor": "accentHover",
        "endBorderColor": "accentHover",
        "hoverBackground": "accentHover",
        "pressedBackground": "#96762A",
        "focusedBorderColor": "bronze"
      }
    },
    "TextField": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "TextArea": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "TextPane": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "EditorPane": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "PasswordField": { "background": "surface" },
    "FormattedTextField": { "background": "surface" },
    "ComboBox": {
      "background": "surface",
      "buttonBackground": "surface",
      "buttonEditableBackground": "surface",
      "selectionBackground": "selection",
      "selectionForeground": "foreground"
    },
    "Spinner": { "background": "surface", "buttonBackground": "surfaceMuted" },
    "List": { "background": "surface", "selectionBackground": "selection", "selectionForeground": "foreground" },
    "Table": {
      "background": "surface",
      "foreground": "foreground",
      "gridColor": "border",
      "stripeColor": "#F2EDE1",
      "selectionBackground": "selection",
      "selectionForeground": "foreground"
    },
    "TableHeader": { "background": "surfaceMuted", "foreground": "foreground", "bottomSeparatorColor": "borderStrong" },
    "Tree": { "background": "surface", "selectionBackground": "selection", "selectionForeground": "foreground" },
    "Menu": { "selectionBackground": "surfaceHover", "selectionForeground": "foreground" },
    "MenuItem": { "selectionBackground": "surfaceHover", "selectionForeground": "foreground", "acceleratorForeground": "mutedForeground" },
    "PopupMenu": { "background": "surface", "borderColor": "borderStrong" },
    "ToolTip": { "background": "#1E1D1A", "foreground": "#F6F2E9", "borderColor": "#1E1D1A" },
    "Separator": { "separatorColor": "border" },
    "ScrollBar": { "track": "canvas", "thumb": "#C0B79F", "hoverThumbColor": "#B8943A" },
    "ProgressBar": { "trackColor": "surfaceMuted", "progressColor": "accent", "indeterminateStartColor": "accentSoft", "indeterminateEndColor": "accent" },
    "TabbedPane": { "underlineColor": "accent", "hoverColor": "surfaceHover", "focusColor": "surfaceHover", "contentAreaColor": "border" },
    "TitlePane": { "background": "canvas", "foreground": "foreground", "inactiveBackground": "surfaceMuted", "inactiveForeground": "mutedForeground" },
    "StatusBar": { "background": "canvas", "borderColor": "border" },
    "Link": { "activeForeground": "link", "hoverForeground": "#74581A", "pressedForeground": "#5E4715", "visitedForeground": "#6E5B3A" },
    "Label": { "disabledForeground": "disabledForeground", "errorForeground": "error", "successForeground": "success" },
    "CheckBox": { "icon": { "selectedBackground": "accent", "selectedBorderColor": "accentHover", "checkmarkColor": "accentForeground", "focusColor": "bronze" } },
    "RadioButton": { "icon": { "selectedBackground": "accent", "selectedBorderColor": "accentHover", "dotColor": "accentForeground", "focusColor": "bronze" } }
  }
}
