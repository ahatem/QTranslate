{
  "name": "Ioskeley Light",
  "dark": false,
  "author": "QTranslate",
  "parentTheme": "IntelliJ",
  "colors": {
    "canvas": "#F2F0EA",
    "surface": "#E6E4DE",
    "surfaceRaised": "#DCDAD4",
    "foreground": "#292826",
    "mutedForeground": "#4E4D49",
    "disabledForeground": "#6E6B65",
    "border": "#D3D0C8",
    "borderStrong": "#BDBAB2",
    "accent": "#913832",
    "accentSoft": "#E2DFD8",
    "accentForeground": "#F2F0EA",
    "selection": "#E2DFD8",
    "selectionInactive": "#E6E4DE",
    "link": "#292826",
    "success": "#4E4D49",
    "warning": "#4E4D49",
    "error": "#292826"
  },
  "ui": {
    "*": {
      "background": "canvas",
      "foreground": "foreground",
      "borderColor": "border",
      "disabledBackground": "surface",
      "disabledForeground": "disabledForeground",
      "inactiveForeground": "mutedForeground",
      "hoverBackground": "selection",
      "selectionBackground": "selection",
      "selectionForeground": "foreground",
      "selectionInactiveBackground": "selectionInactive",
      "selectionInactiveForeground": "foreground",
      "focusColor": "foreground",
      "accentColor": "accent",
      "infoForeground": "mutedForeground"
    },
    "Panel": { "background": "canvas", "foreground": "foreground" },
    "Component": {
      "borderColor": "borderStrong",
      "focusedBorderColor": "foreground",
      "focusColor": "#29282666",
      "errorFocusColor": "accent",
      "warningFocusColor": "mutedForeground"
    },
    "Button": {
      "foreground": "foreground",
      "startBackground": "canvas",
      "endBackground": "canvas",
      "startBorderColor": "borderStrong",
      "endBorderColor": "borderStrong",
      "hoverBackground": "selection",
      "pressedBackground": "surfaceRaised",
      "default": {
        "foreground": "foreground",
        "startBackground": "surfaceRaised",
        "endBackground": "surfaceRaised",
        "startBorderColor": "foreground",
        "endBorderColor": "foreground",
        "hoverBackground": "selection",
        "pressedBackground": "surfaceRaised",
        "focusedBorderColor": "foreground"
      }
    },
    "TextField": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "TextArea": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "TextPane": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "EditorPane": { "background": "surface", "foreground": "foreground", "selectionBackground": "selection" },
    "PasswordField": { "background": "surface" },
    "FormattedTextField": { "background": "surface" },
    "ComboBox": {
      "background": "surface",
      "buttonBackground": "surface",
      "buttonEditableBackground": "surface",
      "selectionBackground": "selection",
      "selectionForeground": "foreground"
    },
    "Spinner": { "background": "surface", "buttonBackground": "surfaceRaised" },
    "List": { "background": "surface", "selectionBackground": "selection", "selectionForeground": "foreground" },
    "Table": {
      "background": "surface",
      "foreground": "foreground",
      "gridColor": "border",
      "stripeColor": "#ECEAE4",
      "selectionBackground": "selection",
      "selectionForeground": "foreground"
    },
    "TableHeader": { "background": "surfaceRaised", "foreground": "foreground", "bottomSeparatorColor": "borderStrong" },
    "Tree": { "background": "surface", "selectionBackground": "selection", "selectionForeground": "foreground" },
    "Menu": { "selectionBackground": "selection", "selectionForeground": "foreground" },
    "MenuItem": { "selectionBackground": "selection", "selectionForeground": "foreground", "acceleratorForeground": "mutedForeground" },
    "PopupMenu": { "background": "surfaceRaised", "borderColor": "borderStrong" },
    "ToolTip": { "background": "#292826", "foreground": "#F2F0EA", "borderColor": "#292826" },
    "Separator": { "separatorColor": "border" },
    "ScrollBar": { "track": "canvas", "thumb": "#6E6B65", "hoverThumbColor": "#4E4D49" },
    "ProgressBar": { "trackColor": "surface", "progressColor": "#4E4D49", "indeterminateStartColor": "selection", "indeterminateEndColor": "#4E4D49" },
    "TabbedPane": { "underlineColor": "accent", "hoverColor": "selection", "focusColor": "selection", "contentAreaColor": "border" },
    "TitlePane": { "background": "canvas", "foreground": "foreground", "inactiveBackground": "surface", "inactiveForeground": "mutedForeground" },
    "StatusBar": { "background": "canvas", "borderColor": "border" },
    "Link": { "activeForeground": "link", "hoverForeground": "link", "pressedForeground": "foreground", "visitedForeground": "mutedForeground" },
    "Label": { "disabledForeground": "disabledForeground", "errorForeground": "error", "successForeground": "success" },
    "CheckBox": { "icon": { "selectedBackground": "accent", "selectedBorderColor": "accent", "checkmarkColor": "accentForeground", "focusColor": "foreground" } },
    "RadioButton": { "icon": { "selectedBackground": "accent", "selectedBorderColor": "accent", "dotColor": "accentForeground", "focusColor": "foreground" } }
  }
}
